# ─────────────────────────────────────────────────────────────
# Cerebro configuration
# Copy to .env and fill in. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=production
# Port the app listens on inside the container
PORT=3000
# Public base URL of the app (used for OIDC redirect URIs, email links)
APP_URL=http://localhost:3000

# Encryption key for the secrets vault (SMTP passwords, connector creds, etc.)
# Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Session signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ─────────────────────────────────────────────────────────────
# Database (Postgres)
# In the bundled stack these point at the `db` service.
# To use an external Postgres, change DATABASE_URL only.
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=cerebro
POSTGRES_PASSWORD=cerebro_change_me
POSTGRES_DB=cerebro
DATABASE_URL=postgresql://cerebro:cerebro_change_me@db:5432/cerebro?schema=public

# ─────────────────────────────────────────────────────────────
# Redis (sessions + background jobs)
# To use an external Redis, change REDIS_URL only.
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────────────────────
# Signal notifications (optional)
# signal-cli is bundled into the app image for the Signal alert channel.
# Override the bundled version here (see github.com/AsamK/signal-cli/releases).
# Account state persists in the cerebro_signal volume at /data/signal.
# ─────────────────────────────────────────────────────────────
SIGNAL_CLI_VERSION=0.14.7

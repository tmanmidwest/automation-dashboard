// Cerebro data model
generator client {
  provider      = "prisma-client-js"
  // native = local dev; the debian targets cover the bookworm-slim container on x64 & arm64.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A role is a named bundle of permission strings (see @cerebro/shared Permission).
/// Modeled as data so granular/per-connector roles can be added without a migration.
model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Array of Permission strings.
  permissions String[]
  /// Built-in roles cannot be deleted from the UI.
  builtin     Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  /// Null for users that only authenticate via an external provider.
  passwordHash String?
  /// How the account was created: 'local' or 'oidc' (informational).
  authProvider String    @default("local")
  disabled     Boolean   @default(false)
  role         Role      @relation(fields: [roleId], references: [id])
  roleId       String
  /// Linked external identities (Google, Entra, Authentik, ...). A user may have several.
  identities   UserIdentity[]
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roleId])
}

/// A configured single-sign-on provider. Multiple can exist, each independently
/// labeled and enabled. Client secrets live in the encrypted vault (key idp:<id>:clientSecret).
model IdentityProvider {
  id              String   @id @default(cuid())
  /// Stable short id used in callback URLs (/api/auth/sso/<slug>/callback).
  slug            String   @unique
  label           String
  /// Protocol. Only 'oidc' for now (discovery-based).
  type            String   @default("oidc")
  issuer          String
  clientId        String
  buttonLabel     String   @default("Sign in with SSO")
  /// UI icon key: google | microsoft | authentik | generic.
  icon            String   @default("generic")
  scopes          String   @default("openid email profile")
  enabled         Boolean  @default(false)
  /// Provisioning policy (per-provider, per the design decision).
  autoCreateUsers Boolean  @default(false)
  defaultRoleSlug String   @default("viewer")
  /// If non-empty, only emails in these domains may sign in / be provisioned.
  allowedDomains  String[]
  sortOrder       Int      @default(0)
  identities      UserIdentity[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Links a Cerebro user to a subject at a specific provider. Unique per (provider, subject).
model UserIdentity {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  provider   IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  subject    String
  email      String?
  createdAt  DateTime         @default(now())

  @@unique([providerId, subject])
  @@index([userId])
}

/// Non-secret application settings (SMTP host/port, OIDC issuer, feature flags...).
/// Values are stored as JSON. Secret values live in the Secret table instead.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// The encrypted secrets vault. Ciphertext only — plaintext never touches the DB.
model Secret {
  key       String   @id
  /// AES-256-GCM: iv:authTag:ciphertext (base64), see CryptoService.
  ciphertext String
  updatedAt DateTime @updatedAt
}

/// An installed connector instance (e.g. a specific Proxmox server).
model ConnectorInstance {
  id           String   @id @default(cuid())
  /// Manifest id, e.g. "proxmox".
  connectorId  String
  /// User-facing label, e.g. "Home Proxmox".
  name         String
  enabled      Boolean  @default(true)
  /// Non-secret config values as JSON. Secret fields are stored in Secret as `connector:<id>:<field>`.
  config       Json     @default("{}")
  /// How often (seconds) background telemetry re-queries this connector's external system.
  refreshIntervalSec Int  @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([connectorId])
}

/// One execution of a connector operation worth keeping (e.g. a Backblaze restore).
/// Durable history so runs survive restarts (the in-memory JobService does not).
model BackupRun {
  id                  String    @id @default(cuid())
  /// The ConnectorInstance this run belongs to.
  connectorInstanceId String
  /// 'restore' | 'schedule' | 'manual'. Always set explicitly by the caller; the
  /// default only matches the initial migration to avoid schema drift.
  trigger             String    @default("schedule")
  /// running | success | error.
  status              String
  /// The operation's result message (what was restored, errors, etc.).
  message             String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?

  @@index([connectorInstanceId, startedAt])
}

model AppLog {
  id        String   @id @default(cuid())
  level     String   // debug | info | warn | error
  context   String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

/// Immutable record of who did what. Append-only; never edited from the UI.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

/// One channel-delivery outcome for a notification — powers the History view.
model NotificationLog {
  id          String   @id @default(cuid())
  /// Alert type key (e.g. 'backup.failure'); null for manual test sends.
  alertKey    String?
  title       String
  severity    String   // info | warning | critical
  source      String?
  channel     String   // email | textbelt | signal
  status      String   // sent | failed | held | throttled
  recipients  Int      @default(0)
  connectorId String?
  /// Error text or extra context.
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([channel])
  @@index([status])
}

// ── Uptime monitoring ────────────────────────────────────────

/// One probed target (ping / http / tcp / dns). Last-known state is
/// denormalized here so the list view needs no per-row heartbeat lookup.
model Monitor {
  id               String   @id @default(cuid())
  name             String
  /// Probe type id: ping | http | tcp | dns
  type             String
  /// Probe-type-specific settings (host, url, keyword, …).
  config           Json     @default("{}")
  enabled          Boolean  @default(true)
  intervalSec      Int      @default(60)
  retryIntervalSec Int      @default(60)
  timeoutSec       Int      @default(10)
  /// Failed checks tolerated before flipping to down.
  retries          Int      @default(1)
  /// While down, re-notify every N failed checks (0 = only on transition).
  resendEveryN     Int      @default(0)
  /// Invert: "up" means the target is unreachable.
  upsideDown       Boolean  @default(false)
  description      String?
  tags             String[]
  sortOrder        Int      @default(0)

  // Last-known state (mirrors the newest heartbeat).
  status         String    @default("pending") // up | down | pending | paused
  lastChangeAt   DateTime?
  lastCheckAt    DateTime?
  lastLatencyMs  Int?
  lastMessage    String?
  certExpiresAt  DateTime?

  heartbeats MonitorHeartbeat[]
  rollups    MonitorRollup[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Raw check results. Pruned after the raw retention window (default 7 days).
model MonitorHeartbeat {
  id        Int      @id @default(autoincrement())
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  status    String   // up | down | pending
  latencyMs Int?
  message   String?
  /// Status changed with this beat — shown in the events list.
  important Boolean  @default(false)
  at        DateTime @default(now())

  @@index([monitorId, at])
  @@index([monitorId, important])
  @@index([at])
}

/// Hourly aggregate of heartbeats, kept for long-range uptime (default 1 year).
model MonitorRollup {
  id           Int      @id @default(autoincrement())
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId    String
  /// Start of the hour (UTC).
  bucket       DateTime
  total        Int
  up           Int
  down         Int
  avgLatencyMs Int?
  minLatencyMs Int?
  maxLatencyMs Int?

  @@unique([monitorId, bucket])
  @@index([bucket])
}
